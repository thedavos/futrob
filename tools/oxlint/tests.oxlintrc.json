// Test-discipline lint, run by `npm run lint:tests` (chained into `npm run check`).
// Kept apart from vite.config.ts because test files are outside the type-aware main lint.
{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": ["vitest"],
  "jsPlugins": [
    {
      "name": "futrob",
      "specifier": "./futrob/index.ts"
    }
  ],
  "ignorePatterns": ["**/node_modules/**", "**/dist/**"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "vitest/no-focused-tests": "error",
        "futrob/no-test-timeout-or-retry": "error",
        "futrob/require-skip-tracking-issue": "error"
      }
    },
    // Legacy allowlist: per-test timeouts that predate futrob/no-test-timeout-or-retry.
    // Remove a file once its timeouts move to project testTimeout or the waits are fixed. Do not add files.
    {
      "files": [
        "**/apps/api/src/adapters/billing/billing-adapters.postgres.integration.test.ts",
        "**/apps/api/src/adapters/competitions/discovery.integration.test.ts",
