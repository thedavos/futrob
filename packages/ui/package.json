{
  "name": "@futrob/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#components/*/index": "./src/components/*/index.ts",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#styles/*": "./src/styles/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles/public.stylex": "./src/styles/public.stylex.ts",
    "./styles/tokens.stylex": "./src/styles/tokens.stylex.ts",
    "./styles/media.stylex": "./src/styles/media.stylex.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./components/*": "./src/components/*.tsx",
    "./components/*/index": "./src/components/*/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "shadcn": "^4.18.0",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
