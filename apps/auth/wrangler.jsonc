{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "futrob-auth",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "vars": {
    "APP_BASE_URL": "https://futrob.app",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://futrob.app",
  },
  "hyperdrive": [
    {
      // Product Postgres (ADR-0021); apps/api/migrations is the only schema history.
      // Replace `id` with the real Hyperdrive config id before the first deploy.
      // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .dev.vars.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
    },
  ],
}
