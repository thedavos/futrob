# Copy to `.env` (gitignored). `npm run dev` loads it; deployed environments set real variables.
# Product Postgres (ADR-0021): the same database as apps/api DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=8788
# Must match apps/web/.dev.vars BETTER_AUTH_SECRET or BFF/SSR session reads fail.
BETTER_AUTH_SECRET=replace-with-a-local-secret-of-32-characters
# Public web origin (cookies and CSRF). Do not leave empty.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8788
APP_BASE_URL=http://localhost:3000
# Must match apps/web/.dev.vars AUTH_PROXY_SECRET: web forwards the client IP with it.
AUTH_PROXY_SECRET=replace-with-a-shared-proxy-secret-of-32-characters
# Header the load balancer sets with the client IP (for example x-real-ip). Leave unset
# locally: the TCP peer is the client.
# AUTH_TRUSTED_IP_HEADER=
# Account emails (email change, password reset): `log` writes the link to the server log.
# Production: AUTH_EMAIL_DELIVERY=resend plus EMAIL_FROM and the RESEND_API_KEY secret.
AUTH_EMAIL_DELIVERY=log
# Keep NODE_ENV=development so Sentry never sends from this machine.
NODE_ENV=development
# Production only:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
