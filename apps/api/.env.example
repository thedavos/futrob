# Copy to `.env` for local runs (`cp .env.example .env`).
# `.env` is gitignored. Values already set in the shell win.

PORT=8787
NODE_ENV=development

# Railway Postgres (optional locally — /meta/health reports db: skipped if unset;
# organizations fall back to in-memory adapters)
DATABASE_URL=

# Shared with apps/web BFF for trusted ActorId calls (must match web INTERNAL_JOB_SECRET)
INTERNAL_JOB_SECRET=local-internal-job-secret-at-least-thirty-two-chars
# Optional one-time bootstrap. Ignored after the first persisted superuser exists.
INITIAL_SUPERUSER_ACTOR_ID=

# EA Clubs egress
EA_CLUBS_BASE_URL=https://proclubs.ea.com/api/fc

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
