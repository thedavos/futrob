# Copy to `.env` for local runs (`cp .env.example .env`).
# `.env` is gitignored. Values already set in the shell win.

PORT=8787
NODE_ENV=development

# Product Postgres — Neon in development, Railway in production. Also holds auth,
# actors (ADR-0021) and web BFF rate limits (ADR-0034), so it is required to sign in. Apply schema with
# `npm run migrate -w @futrob/api`. Without it the API alone runs on in-memory adapters
# (/meta/health reports db: skipped).
DATABASE_URL=

# Shared with apps/web BFF for trusted ActorId calls (must match web INTERNAL_JOB_SECRET)
INTERNAL_JOB_SECRET=local-internal-job-secret-at-least-thirty-two-chars
# Optional one-time bootstrap. Ignored after the first persisted superuser exists.
INITIAL_SUPERUSER_ACTOR_ID=

# Automatic Results audit actor. Provision through apps/auth, then configure its
# ActorId. Must already exist in actors; the expiry runner returns 503 until it does.
# No Team/operator grants are needed; attribution is capacity=system.
RESULTS_SYSTEM_ACTOR_ID=

# EA Clubs egress
EA_CLUBS_BASE_URL=https://proclubs.ea.com/api/fc

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sentry (leave blank locally; events send only when NODE_ENV=production AND DSN is set)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Scheduling expiry recovery: existing actor provisioned by auth; independent of Results policy.
SCHEDULING_SYSTEM_ACTOR_ID=

# Email (ADR-0031). Without RESEND_API_KEY and EMAIL_FROM, development keeps email in memory
# and production leaves it pending in email_outbox. Never commit a real key.
RESEND_API_KEY=
EMAIL_FROM=Futrob <avisos@futrob.app>
# Web origin for email links and the unsubscribe page
WEB_BASE_URL=http://localhost:3000

# Web BFF rate limits (ADR-0034): apps/web asks POST /internal/rate-limits/check, which counts
# per actor and IP in app_rate_limit_windows. Without the secret the check answers 503 and the
# BFF refuses limited routes, except where web ENVIRONMENT=development skips them.
# Generate one, e.g. `openssl rand -hex 32`; never reuse a published value.
RATE_LIMIT_FINGERPRINT_SECRET=

# Optional overrides of the policy defaults shown here.
RATE_LIMIT_EA_CLUB_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_EA_CLUB_SEARCH_ACTOR_MAX=10
RATE_LIMIT_EA_CLUB_SEARCH_IP_MAX=30
RATE_LIMIT_INVITATION_ACCEPT_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_ACCEPT_ACTOR_MAX=5
RATE_LIMIT_INVITATION_ACCEPT_IP_MAX=5
RATE_LIMIT_INVITATION_PREVIEW_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_PREVIEW_ACTOR_MAX=5
RATE_LIMIT_INVITATION_PREVIEW_IP_MAX=5
RATE_LIMIT_INVITATION_PUBLIC_PREVIEW_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_PUBLIC_PREVIEW_ACTOR_MAX=30
RATE_LIMIT_INVITATION_PUBLIC_PREVIEW_IP_MAX=30
RATE_LIMIT_PLAYER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_PLAYER_SEARCH_ACTOR_MAX=30
RATE_LIMIT_PLAYER_SEARCH_IP_MAX=60
RATE_LIMIT_PUBLIC_CLUB_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_CLUB_SEARCH_ACTOR_MAX=20
RATE_LIMIT_PUBLIC_CLUB_SEARCH_IP_MAX=20
RATE_LIMIT_PUBLIC_COMPETITION_EXPLORE_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_COMPETITION_EXPLORE_ACTOR_MAX=30
RATE_LIMIT_PUBLIC_COMPETITION_EXPLORE_IP_MAX=30
