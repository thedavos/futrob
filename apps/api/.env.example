# Copy to `.env` for local runs (`cp .env.example .env`).
# `.env` is gitignored. Values already set in the shell win.

PORT=8787
NODE_ENV=development

# Railway Postgres (optional locally — /meta/health reports db: skipped if unset)
DATABASE_URL=

# EA Clubs egress
EA_CLUBS_BASE_URL=https://proclubs.ea.com/api/fc

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
