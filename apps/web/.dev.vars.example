BETTER_AUTH_SECRET=replace-with-a-local-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Local Wrangler / Vite plugin. Skips BFF rate limits (club search, invitations), so the
# BFF does not ask apps/api to count them (ADR-0034).
ENVIRONMENT=development
# Keep NODE_ENV=development so Sentry never sends from this machine.
NODE_ENV=development
# Production only: `wrangler secret put SENTRY_DSN --config apps/web/wrangler.jsonc`
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Overrides wrangler.jsonc so the BFF talks to local apps/api, not production.
FUTROB_API_BASE_URL=http://localhost:8787/api/v1
# apps/auth (Node) on :8788. AUTH_PROXY_SECRET must match apps/auth/.env.
FUTROB_AUTH_BASE_URL=http://localhost:8788
AUTH_PROXY_SECRET=replace-with-a-shared-proxy-secret-of-32-characters
INTERNAL_JOB_SECRET=replace-with-the-same-value-as-apps-api
