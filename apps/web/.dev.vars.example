BETTER_AUTH_SECRET=replace-with-a-local-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Local Wrangler / Vite plugin. Skips BFF rate limits (club search, invitations).
ENVIRONMENT=development
# Overrides wrangler.jsonc so the BFF talks to local apps/api, not production.
FUTROB_API_BASE_URL=http://localhost:8787/api/v1
INTERNAL_JOB_SECRET=replace-with-the-same-value-as-apps-api
RATE_LIMIT_FINGERPRINT_SECRET=replace-with-an-independent-random-secret

# Optional overrides; used when ENVIRONMENT is not development. Application defaults are shown.
RATE_LIMIT_EA_CLUB_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_EA_CLUB_SEARCH_ACTOR_MAX=10
RATE_LIMIT_EA_CLUB_SEARCH_IP_MAX=30
RATE_LIMIT_INVITATION_ACCEPT_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_ACCEPT_ACTOR_MAX=5
RATE_LIMIT_INVITATION_ACCEPT_IP_MAX=5
RATE_LIMIT_INVITATION_PREVIEW_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_PREVIEW_ACTOR_MAX=5
RATE_LIMIT_INVITATION_PREVIEW_IP_MAX=5
