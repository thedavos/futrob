{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futrob-web",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "upload_source_maps": true,
  "vars": {
    "APP_BASE_URL": "https://futrob.app",
    // Local `apps/web/.dev.vars` overrides this to development so Sentry stays off.
    "NODE_ENV": "production",
    // Local override: FUTROB_API_BASE_URL in apps/web/.dev.vars
    "FUTROB_API_BASE_URL": "https://api.futrob.app/api/v1",
    // apps/auth (Node). Local override in apps/web/.dev.vars. AUTH_PROXY_SECRET is a secret.
    "FUTROB_AUTH_BASE_URL": "https://auth.futrob.app",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "futrob-media",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "futrob-job-queue",
      },
    ],
    "consumers": [
      {
        "queue": "futrob-job-queue",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "futrob-job-dlq",
      },
    ],
  },
}
