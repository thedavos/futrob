# Copy to `.env` (gitignored). Read by `wrangler dev` / the Cloudflare Vite plugin, not by .dev.vars.
# Local target for the HYPERDRIVE binding (ADR-0021): the same Postgres as apps/api DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/dbname?sslmode=require
