# Base URL of the product web app serving /api/v1 (Bearer auth).
# iOS simulator: http://localhost:3000 · Android emulator: http://10.0.2.2:3000
# Physical device: use your machine's LAN IP.
EXPO_PUBLIC_FUTROB_API_BASE_URL=http://localhost:3000

# Better Auth origin — apps/auth worker (ADR-0015).
# Falls back to EXPO_PUBLIC_FUTROB_API_BASE_URL (web proxy) when unset.
EXPO_PUBLIC_FUTROB_AUTH_BASE_URL=http://localhost:8788

# Sentry (leave blank locally). Expo Go / __DEV__ never send events even if set.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# EAS native source maps: set SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT as EAS secrets.
# Never commit those values or a .env.local.
