{
  "name": "futrob",
  "version": "0.1.0",
  "private": true,
  "description": "Futrob — EA FC Clubs competition platform on Cloudflare Workers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --no-hooks && node tools/stylex/guard-unplugin-css.cjs",
    "dev": "vp run --parallel --log labeled -F @futrob/web -F @futrob/api -F @futrob/auth --fail-if-no-match --ignore-depends-on dev",
    "dev:web": "vp dev apps/web",
    "dev:api": "npm run dev -w @futrob/api",
    "web": "npm run dev:web",
    "web:build": "cross-env NODE_ENV=production vp build apps/web",
    "web:preview": "vp preview apps/web",
    "web:deploy": "npm run deploy -w @futrob/web",
    "web:typecheck": "npm run typecheck -w @futrob/web",
    "web:test": "npm run test -w @futrob/web",
    "api": "npm run dev:api",
    "api:start": "npm run start -w @futrob/api",
    "api:typecheck": "npm run typecheck -w @futrob/api",
    "api:test": "npm run test -w @futrob/api",
    "cli": "npm run cli -w @futrob/cli --",
    "cli:typecheck": "npm run typecheck -w @futrob/cli",
    "build": "npm run web:build",
    "bundle:budget": "node apps/web/scripts/check-client-bundle-budget.mjs",
    "preview": "npm run web:preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vp run -r typecheck",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "ui:storybook": "npm run storybook",
    "ui:storybook:build": "npm run storybook:build",
    "generate:openapi": "npm run generate:openapi -w @futrob/api",
    "openapi:check": "npm run generate:openapi && git diff --exit-code packages/api-contracts/openapi",
    "generate:routes": "npm run generate:routes -w @futrob/web"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@futrob/api-contracts": "^0.1.0",
    "@futrob/web": "^0.1.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/devtools-vite": "^0.8.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "^10.1.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "expo": "~57.0.15",
    "expo-router": "~57.0.15",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.86.2",
    "storybook": "10.6.5",
    "typescript": "6.0.2",
    "vite-plus": "0.3.3"
  },
  "overrides": {
    "@vitest/browser": "$@vitest/browser",
    "@vitest/browser-playwright": "$@vitest/browser-playwright",
    "@vitest/browser-preview": "4.1.11",
    "@vitest/coverage-v8": "$@vitest/coverage-v8",
    "@vitest/expect": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "@vitest/pretty-format": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "@vitest/spy": "4.1.11",
    "@vitest/utils": "4.1.11",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "react-server-dom-webpack": "~19.2.4",
    "storybook": {
      "vite-plus": "$vite-plus"
    },
    "tinypool": "2.2.0",
    "uuid": "11.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "lefthook": false,
    "sharp": true,
    "workerd": true
  }
}
