{
  "name": "futrob",
  "version": "0.1.0",
  "private": true,
  "description": "Futrob — EA FC Clubs competition platform on Cloudflare Workers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --parallel --log labeled -F @futrob/web -F @futrob/api --fail-if-no-match --ignore-depends-on dev",
    "dev:web": "vp dev apps/web",
    "dev:api": "npm run dev -w @futrob/api",
    "web": "npm run dev:web",
    "web:build": "vp build apps/web",
    "web:preview": "vp preview apps/web",
    "web:deploy": "npm run deploy -w @futrob/web",
    "web:typecheck": "npm run typecheck -w @futrob/web",
    "web:test": "npm run test -w @futrob/web",
    "api": "npm run dev:api",
    "api:start": "npm run start -w @futrob/api",
    "api:typecheck": "npm run typecheck -w @futrob/api",
    "api:test": "npm run test -w @futrob/api",
    "cli": "npm run cli -w @futrob/cli --",
    "cli:typecheck": "npm run typecheck -w @futrob/cli",
    "build": "npm run web:build",
    "bundle:budget": "node apps/web/scripts/check-client-bundle-budget.mjs",
    "preview": "npm run web:preview",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vp run -r typecheck",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "ui:storybook": "npm run storybook",
    "ui:storybook:build": "npm run storybook:build",
    "generate:openapi": "npm run generate:openapi -w @futrob/api-contracts"
  },
  "devDependencies": {
    "@futrob/api-contracts": "^0.1.0",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/devtools-vite": "^0.8.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadow-plugin": "^1.2.6",
    "storybook": "10.5.7",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.2",
    "vite-plus": "0.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
